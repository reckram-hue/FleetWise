rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Health probe: keep temporarily open during staging, then lock down.
    match /fw_health/{docId} {
      allow read, write: if request.time < timestamp.date(2099, 1, 1);
    }

    // TEMPORARY: Allow unauthenticated access for development
    // TODO: Implement proper authentication and role-based access control for production
    match /users/{docId} {
      allow read, write: if true;
    }

    match /vehicles/{docId} {
      allow read, write: if true;
    }

    match /shifts/{docId} {
      allow read, write: if true;
    }

    match /defects/{docId} {
      allow read, write: if true;
    }

    match /costs/{docId} {
      allow read, write: if true;
    }

    match /maintenanceRecords/{docId} {
      allow read, write: if true;
    }

    match /scheduledServices/{docId} {
      allow read, write: if true;
    }

    match /driverFines/{docId} {
      allow read, write: if true;
    }

    match /vehicleDamages/{docId} {
      allow read, write: if true;
    }

    match /refuelRecords/{docId} {
      allow read, write: if true;
    }

    match /chargeRecords/{docId} {
      allow read, write: if true;
    }

    match /serviceProviders/{docId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /fuelEconomyAlerts/{docId} {
      allow read, write: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
