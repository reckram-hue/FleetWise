# FleetWise Johannesburg production Firebase web configuration (TEMPLATE)
# Copy to an environment-specific local/deployment secret store and fill in the
# values issued by the fleetwise-prod-jhb Firebase web app. Do not commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=fleetwise-prod-jhb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fleetwise-prod-jhb
VITE_FIREBASE_STORAGE_BUCKET=fleetwise-prod-jhb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Reserved for the future additive frontend region selector. The current
# src/lib/firebase.ts intentionally remains unchanged and still uses us-central1.
VITE_FIREBASE_FUNCTIONS_REGION=africa-south1
