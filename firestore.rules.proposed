rules_version = '2';
// PROPOSED FleetWise Firestore rules — least privilege, default deny.
// NOT deployed. This is a design/local-validation artifact for WP5B/WP5C.
// Cloud Functions (Admin SDK) bypass these rules, so the secure bridge keeps working.
//
// WP5C STATUS: All user/defect operations are now behind secure callable functions.
// The browser no longer needs direct reads/writes to the users collection.
// Defect creation by drivers goes through the reportDefect callable (PIN-verified).
// Admin CRUD goes through createDriver/updateDriver/deleteDriver/updateEmploymentStatus callables.
// Admin creation goes through createAdminUser callable (Admin Auth server-side).
// Safe user listing for driver-selection uses listDriversSafe callable.
// Admin user listing uses listUsersAdmin callable.
// Admin profile uses getAdminProfile callable.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = Firebase Auth user whose users/{uid} doc has role == 'admin'.
    // get() here is a rules-internal read and is NOT blocked by the users match below.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- users ----
    // DENY all direct client access. Firestore rules cannot redact fields, and the
    // documents contain pinHash. All user operations go through Cloud Functions:
    //   - listDriversSafe (public, safe fields only)
    //   - getAdminProfile (auth required)
    //   - listUsersAdmin (admin only)
    //   - createDriver, updateDriver, deleteDriver, updateEmploymentStatus (admin only)
    //   - createAdminUser (admin only)
    match /users/{userId} {
      allow read, write: if false;
    }

    // ---- vehicles ----
    // Fleet data (no PII): readable by anyone; writes are admin-only.
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- shifts ----
    // Historical/stat visibility is public; start/end are owned by Cloud Functions.
    match /shifts/{shiftId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ---- defects ----
    // Public read for driver defect visibility.
    // Direct create is BLOCKED — driver defect creation goes through reportDefect callable (PIN-verified).
    // Admin can update/delete defects directly (status changes, assignments, resolution).
    match /defects/{defectId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ---- admin-only operational collections ----
    match /costs/{id} { allow read, write: if isAdmin(); }
    match /maintenanceRecords/{id} { allow read, write: if isAdmin(); }
    match /scheduledServices/{id} { allow read, write: if isAdmin(); }
    match /driverFines/{id} { allow read, write: if isAdmin(); }
    match /vehicleDamages/{id} { allow read, write: if isAdmin(); }
    match /serviceProviders/{id} { allow read, write: if isAdmin(); }
    match /settings/{id} { allow read, write: if isAdmin(); }
    match /fuelEconomyAlerts/{id} { allow read, write: if isAdmin(); }

    // ---- fw_health ----
    match /fw_health/{id} { allow read, write: if isAdmin(); }

    // ---- driver-logged fuel/charge ----
    // Readable for stats; writes are BLOCKED (no driver auth identity) and must move
    // behind Cloud Functions before live lockdown. (Forms are currently unwired.)
    // NOT implemented in WP5C — deferred to dedicated energy/fuel work package.
    match /refuelRecords/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }
    match /chargeRecords/{id} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ---- server-only ----
    match /rateLimits/{id} { allow read, write: if false; }

    // ---- driverSessions ----
    // Bearer-credential session store (WP6A). All reads and writes go through Cloud Functions
    // via the Admin SDK. The document ID is the SHA-256 hash of the session token.
    // Client access is unconditionally denied — the hash must never be readable by browsers.
    match /driverSessions/{sessionId} { allow read, write: if false; }

    // ---- vehicleAssignments ----
    // Server-only (WP7B). Created/read/ended exclusively through session-authenticated
    // Cloud Functions via the Admin SDK. Direct client access is denied.
    match /vehicleAssignments/{assignmentId} { allow read, write: if false; }

    // ---- default deny ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
